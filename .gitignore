# --- Local-only development material (kept on disk, not published) ---
docs/
spike/

# Icon working files — only the three sized PNGs are published
icons/*
!icons/icon-16.png
!icons/icon-48.png
!icons/icon-128.png

# Source art dropped in the repo root (Midjourney renders, references)
/Snow_*.png
